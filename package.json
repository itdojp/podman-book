{
  "name": "podman-book",
  "version": "1.0.0",
  "description": "コンテナ技術の理論と実践 - エンタープライズ環境でのPodman活用法",
  "author": "株式会社アイティードゥ",
  "license": "CC-BY-NC-SA-4.0",
  "scripts": {
    "build": "node scripts/node-build.js",
    "serve": "cd dist && python3 -m http.server 4000 || python -m http.server 4000",
    "deploy": "npm run build && gh-pages -d dist",
    "deploy-setup": "gh-pages-clean",
    "validate-deploy": "node scripts/validate-github-pages.js",
    "pages-status": "node scripts/check-pages-status.js",
    "dev": "npm run build && npm run serve",
    "check:metadata": "node scripts/check-metadata-consistency.js && npm run check:chapter-structure",
    "check:chapter-structure": "node scripts/check-chapter-structure.js && node scripts/check-chapter-structure-regression.js",
    "check:security": "npm audit",
    "check:figure-index": "node scripts/check-figure-index.js",
    "check:screenshots": "node scripts/check-screenshot-contract.js && node scripts/check-screenshot-contract-regression.js",
    "check:podman-backends": "node scripts/check-podman-backend-contract.js && node scripts/check-podman-backend-contract-regression.js",
    "check:podman-machine-paths": "node scripts/check-podman-machine-path-contract.js && node scripts/check-podman-machine-path-contract-regression.js",
    "check:docker-rootless-comparison": "node scripts/check-docker-rootless-comparison.js && node scripts/check-docker-rootless-comparison-regression.js",
    "check:literal-templates": "node scripts/check-literal-template-rendering.js && node scripts/check-literal-template-rendering-regression.js",
    "test": "npm run check:metadata && npm run check:figure-index && npm run check:screenshots && npm run check:podman-backends && npm run check:podman-machine-paths && npm run check:docker-rootless-comparison && npm run check:literal-templates && npm run build"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/itdojp/podman-book.git"
  },
  "homepage": "https://itdojp.github.io/podman-book/",
  "bugs": {
    "url": "https://github.com/itdojp/podman-book/issues"
  }
}
